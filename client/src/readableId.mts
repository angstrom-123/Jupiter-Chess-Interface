export function humanReadableId(): string {
    const randomFromArray = (array: string[]) => {
        return array[Math.floor(Math.random() * array.length)]!;
    };

    const adjective1: string = randomFromArray(adjectives);
    const adjective2: string = randomFromArray(adjectives);
    const noun: string = randomFromArray(nouns);

    return `${adjective1}-${adjective2}-${noun}`;
}
